# Copy this file to .env and fill in the values. Never commit .env.

# Neon Postgres connection string.
# https://console.neon.tech -> your project -> "Connection Details" -> pooled URL.
DATABASE_URL=

# Secret used by Auth.js to sign session/JWT cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth App credentials.
# https://github.com/settings/developers -> "New OAuth App".
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Chapa secret key, used for payment initialize/verify.
# https://dashboard.chapa.co -> Settings -> API Keys (starts with CHASECK_TEST- or CHASECK-).
CHAPA_SECRET_KEY=

# Chapa v1 Direct Charge secret key, used for mobile money charges.
# Same dashboard as above. Starts with CHASECK_TEST- or CHASECK-.
CHAPA_V1_SECRET_KEY=

# Chapa webhook signing secret, used to verify callback authenticity.
# https://dashboard.chapa.co -> Developers -> Webhooks.
CHAPA_WEBHOOK_SECRET=

# Chapa publishable/public key. Currently unused by the code; kept for client-side use later.
NEXT_PUBLIC_CHAPA_PUBLIC_KEY=

# Base URL of the app, used to build payment redirect/callback links.
# For local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=

# Set to "true" to approve simulated mobile-money payments without Chapa.
# Only read outside production. MUST NEVER be set in production: it grants
# the Pro plan without a real payment.
ENABLE_MOCK_PAYMENTS=
