{
  "$schema": "https://developers.cloudflare.com/schemas/wrangler.jsonc",
  "name": "hulu-code",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://hulu-code.rootknown123.workers.dev"
  },
  "observability": {
    "enabled": true
  }
}
